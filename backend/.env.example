# Copy to .env for local development. Never commit the real .env file.

# Django
SECRET_KEY=django-insecure-dev-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (defaults to SQLite if unset)
# DATABASE_URL=postgres://user:password@localhost:5432/eld_trip_planner

# CORS — the deployed frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Trip defaults
DEFAULT_TRIP_TIMEZONE=America/Chicago

# Geocoding (Nominatim) — a real, identifying User-Agent is required by
# Nominatim's usage policy: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=eld-trip-planner (you@example.com)

# Routing (OSRM public demo server; no key required)
OSRM_BASE_URL=https://router.project-osrm.org

# Routing fallback (OpenRouteService) — used automatically if OSRM fails
# and this key is set. Free tier: https://openrouteservice.org/dev/#/signup
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=

UPSTREAM_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
